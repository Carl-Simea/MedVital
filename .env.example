# Copy to .env for local use. Never commit real credentials.

# Backend ---------------------------------------------------------------
# Observation store: "memory" (default; data lost on restart) or "postgres"
# ("postgres" is architecture only in v0.1 — see docs/DECISIONS.md D-006).
MEDVITAL_REPOSITORY=memory
# Only read when MEDVITAL_REPOSITORY=postgres
MEDVITAL_DATABASE_URL=postgresql://medvital:change-me@localhost:5432/medvital
# Comma-separated allowed browser origins for CORS
MEDVITAL_CORS_ORIGINS=http://localhost:5173

# docker-compose.yml (local PostgreSQL)
POSTGRES_PASSWORD=change-me

# Link to Earth on Cloudflare (cloudflare/ Worker, see README). start.py reads this file.
# Leave both empty to send straight to the NASA receiver.
MEDVITAL_CLOUDFLARE_URL=
MEDVITAL_CLOUDFLARE_KEY=
# Optional: a local model for the onboard agent
MEDVITAL_OLLAMA_MODEL=
