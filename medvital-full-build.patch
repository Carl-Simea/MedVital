@@ -0,0 +1,31 @@
+/* Shared tokens for the MedVital apps. Fonts are ones already on the laptops (no internet needed):
+   Bahnschrift ships with Windows 10+, DIN Alternate with macOS. */
+:root {
+  --font: "Bahnschrift", "DIN Alternate", "Barlow", "Roboto Condensed", "Segoe UI", system-ui, sans-serif;
+  --habitat: #eef1f4;   /* panel white of a habitat module */
